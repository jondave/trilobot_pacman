{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Fetch vendor libs",
      "type": "shell",
      "command": "bash scripts/fetch_vendor.sh",
      "problemMatcher": []
    },
    {
      "label": "uv sync",
      "type": "shell",
      "command": "uv sync",
      "problemMatcher": []
    },
    {
      "label": "Run Blockly app (uv)",
      "type": "shell",
      "command": "uv run python control_scripts/blockly/app.py",
      "problemMatcher": [],
      "options": {
        "env": {
          "PORT": "8750",
          "HOST": "127.0.0.1"
        }
      }
    },
    {
      "label": "Run fake robot (uv)",
      "type": "shell",
      "command": "uv run python robot_scripts/robot_sender.py --fake --host 127.0.0.1 --port 8765",
      "problemMatcher": []
    },
    {
      "label": "Tests (uv)",
      "type": "shell",
      "command": "uv run pytest -q",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Ruff (uv)",
      "type": "shell",
      "command": "uv run ruff check .",
      "problemMatcher": []
    }
  ]
}
