# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local configuration and secrets
.env
.env.*
!.env.example

# Local Flask/runtime output
instance/
*.log

# Blockly browser saves are stored in localStorage, but ignore accidental exports
*.blockly.json
control_scripts/blockly/demos/saved/

# OS/editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp

# Frontend libraries fetched by scripts/fetch_vendor.sh
control_scripts/blockly/static/vendor/

# Local Ansible inventory (copy of robot_scripts/ansible/inventory.example.ini)
robot_scripts/ansible/inventory.ini
